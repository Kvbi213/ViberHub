# ==============================================================================
# VIBEHUB // ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# UWAGA: Wszelkie klucze i tokeny pobierane wyłącznie z konfiguracji środowiskowej.
# ZAKAZ hardcodowania jakichkolwiek wartości produkcyjnych.
# ==============================================================================

# --- FIREBASE CLIENT (apps/web) ---
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=""

# --- FIREBASE ADMIN / BACKEND (apps/web/api & Cloud Functions) ---
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# --- VIBEHUB API CONFIGURATION ---
NEXT_PUBLIC_API_BASE_URL="http://localhost:3000/api/v1"

# --- LOCAL BRIDGE CONFIGURATION (apps/bridge) ---
VIBEHUB_API_URL="http://localhost:3000/api/v1"
VIBEHUB_DEVICE_ID=""
VIBEHUB_DEVICE_TOKEN=""
VIBEHUB_HEARTBEAT_INTERVAL_MS="15000"
VIBEHUB_EVENT_BATCH_INTERVAL_MS="2000"
VIBEHUB_LOG_LEVEL="info"
