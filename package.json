    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "dependencies": {
    "@vibehub/contracts": "workspace:*",
    "@vibehub/event-protocol": "workspace:*",
    "firebase": "^10.14.1",
    "zod": "^3.23.8"
  }
}
